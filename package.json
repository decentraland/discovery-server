{
  "name": "discovery-server",
  "version": "1.0.0",
  "description": "Discovery Server - Processes Catalysts' scenes and Worlds deployments",
  "author": "Decentraland",
  "repository": {
    "type": "git",
    "url": "https://github.com/decentraland/discovery-server"
  },
  "bugs": {
    "url": "https://github.com/decentraland/discovery-server/issues"
  },
  "homepage": "https://github.com/decentraland/discovery-server#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec 'ts-node src/index.ts'",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "migrate": "./node_modules/.bin/node-pg-migrate --envPath ./.env.default --tsconfig ./tsconfig.json -j ts -m ./src/migrations -d CONNECTION_STRING"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@well-known-components/test-helpers": "^1.5.8",
    "nodemon": "^3.1.10",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/sqs-component": "^2.0.3",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/http-server": "^2.1.0",
    "@well-known-components/interfaces": "^1.5.1",
    "@well-known-components/logger": "^3.1.3",
    "@well-known-components/metrics": "^2.1.0",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2"
  }
}
