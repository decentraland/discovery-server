{
  "name": "discovery-server",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "dev": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --ignore 'src/migrations' --exec 'ts-node src/index.ts'",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose -c jest.config.js",
    "test:unit": "jest --forceExit --detectOpenHandles --verbose -c jest.config.js",
    "test:integration:before": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration": "yarn test:integration:before && jest --forceExit --detectOpenHandles --verbose -c jest.integration.config.js --runInBand",
    "migrate": "node-pg-migrate --database-url-var PG_COMPONENT_PSQL_CONNECTION_STRING --envPath .env -j ts --tsconfig tsconfig.json -m ./src/migrations",
    "etl": "ts-node scripts/etl/index.ts",
    "parity": "ts-node test/parity/run-parity.ts",
    "lint:check": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint '**/*.{js,ts}' --fix"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.2.1",
    "@dcl/test-helpers": "^0.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/client-sns": "^3.734.0",
    "@aws-sdk/client-sqs": "^3.826.0",
    "@aws-sdk/lib-storage": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@dcl/core-commons": "^0.10.1",
    "@dcl/crypto-middleware": "^4.1.1",
    "@dcl/features-component": "^1.0.2",
    "@dcl/fetch-component": "^1.1.1",
    "@dcl/http-commons": "^2.0.0",
    "@dcl/http-server": "^2.1.0",
    "@dcl/job-component": "^0.3.5",
    "@dcl/metrics": "^1.0.1",
    "@dcl/pg-component": "^0.2.0",
    "@dcl/queue-consumer-component": "^3.0.5",
    "@dcl/schema-validator-component": "^1.0.1",
    "@dcl/schemas": "^26.5.0",
    "@dcl/slack-component": "^1.1.1",
    "@dcl/sns-component": "^3.1.5",
    "@dcl/sqs-component": "^2.2.5",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/interfaces": "^1.5.2",
    "@well-known-components/logger": "^3.1.3",
    "lru-cache": "^10.4.3",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.11.0",
    "rrule": "^2.8.1",
    "sql-template-strings": "^2.2.2"
  }
}
