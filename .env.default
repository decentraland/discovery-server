# This file should be safe to commit and acts as documentation for all the
# possible configurations of the server. Precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents

# ── HTTP server ────────────────────────────────────────────────────────────
HTTP_SERVER_PORT=5000
HTTP_SERVER_HOST=0.0.0.0
HTTP_FETCH_TIMEOUT_MS=30000
# Max request body size in bytes (larger bodies are rejected with 413 before buffering).
HTTP_MAX_BODY_SIZE=1048576

# ── Database ───────────────────────────────────────────────────────────────
PG_COMPONENT_PSQL_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/discovery

# ── Auth ───────────────────────────────────────────────────────────────────
# Comma-separated wallet addresses granted admin (union of legacy places+events lists)
ADMIN_ADDRESSES=
# Unified service-admin bearer accepted on moderation routes (replaces the legacy
# PLACES_ADMIN_AUTH_TOKEN + EVENTS_ADMIN_AUTH_TOKEN). Empty = signed-fetch admin only.
API_ADMIN_TOKEN=
# Transition aliases also accepted during token rotation (drop after consumers migrate)
LEGACY_PLACES_ADMIN_AUTH_TOKEN=
LEGACY_EVENTS_ADMIN_AUTH_TOKEN=
# Data-team ranking pipeline bearer (kept separate)
DATA_TEAM_AUTH_TOKEN=
# Comma-separated addresses shown as "Decentraland Foundation" as the event creator
FOUNDATION_ADDRESSES=

# ── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Localstack endpoint for local/integration; empty in prod (uses IAM task role)
AWS_ENDPOINT=
# Static credentials; leave empty in prod to use the IAM task role (localstack uses dummies)
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=
# Content-moderation reports bucket (was places AWS_BUCKET_NAME)
CONTENT_MODERATION_BUCKET_NAME=
CONTENT_MODERATION_BUCKET_HOSTNAME=
# Event posters bucket (was events AWS_BUCKET_NAME)
POSTER_BUCKET_NAME=
POSTER_BUCKET_URL=
# Public assets bucket for the Genesis City manifest (empty disables the manifest job)
PUBLIC_BUCKET=
# SNS notifications topic (events lifecycle notifications); empty disables publishing
AWS_SNS_ARN=
AWS_SNS_ENDPOINT=
# SQS deployments queue (Catalyst/worlds deployment ingestion); empty disables the consumer
AWS_SQS_QUEUE_URL=
AWS_SQS_ENDPOINT=

# ── Downstream services ──────────────────────────────────────────────────────
# Catalyst lambdas (owner=operated-lands filter)
CATALYST_URL=https://peer.decentraland.org
# Data-team scene-stats CDN (place user_visits)
DATA_TEAM_URL=https://cdn-data.decentraland.org
# Realtime scene/world occupancy
COMMS_GATEKEEPER_URL=
REALM_PROVIDER_URL=
WORLDS_LIVE_DATA=
# Subgraphs for world name-owner resolution during ingestion
MARKETPLACE_SUBGRAPH_URL=https://subgraph.decentraland.org/marketplace
ENS_SUBGRAPH_URL=https://subgraph.decentraland.org/ens
# Communities API (event community ownership + EVENT_STARTED member fan-out)
COMMUNITIES_API_URL=
COMMUNITIES_API_ADMIN_TOKEN=
# Land API (event-create estate metadata + default map image)
LAND_URL=https://api.decentraland.org
# POI list source (empty = POI sync is a no-op)
DCL_LISTS_URL=https://dcl-lists.decentraland.org
# Snapshot voting-power (like/favorite weighting)
SNAPSHOT_SCORE_URL=https://score.snapshot.org/
SNAPSHOT_SPACE=snapshot.dcl.eth
# TTL (ms) for the scene-stats cache (30-day visit counts)
SCENE_STATS_TTL_MS=3600000

# ── Slack (via @dcl/slack-component; bot token + per-domain channels) ─────────
# Empty token = Slack alerting is a no-op.
SLACK_BOT_TOKEN=
SLACK_CONTENT_MODERATION_CHANNEL=
SLACK_EVENTS_CHANNEL=
# Fallback channel when a notifier call omits an explicit channel
SLACK_DEFAULT_CHANNEL=

# ── Link building ────────────────────────────────────────────────────────────
PLACES_BASE_URL=https://places.decentraland.org
EVENTS_BASE_URL=https://events.decentraland.org

# ── Background jobs ──────────────────────────────────────────────────────────
# Master kill-switch for all crons/consumers (recurrence refresh, notifications,
# POI sync, cache refreshers, SQS deployment consumer). Off by default so exactly
# one deployment owns background work during cutover.
BACKGROUND_JOBS_ENABLED=false
# Interval (ms) for the recurrence next-occurrence refresh job.
UPDATE_NEXT_START_AT_INTERVAL_MS=60000
# Interval (ms) for the three SNS notification crons.
NOTIFICATIONS_INTERVAL_MS=60000
# TTL (ms) for the hot-scenes and worlds-live-data caches / refresh crons.
HOT_SCENES_TTL_MS=60000
WORLDS_LIVE_DATA_TTL_MS=60000
# TTL (ms) for the live-events snapshot cache that backs destination live/next-event decoration.
LIVE_EVENTS_TTL_MS=20000
# Interval (ms) for the POI category sync job.
POI_SYNC_INTERVAL_MS=86400000
# Interval (ms) for the Genesis City manifest rebuild job.
MANIFEST_REFRESH_INTERVAL_MS=600000

# ── Metrics ──────────────────────────────────────────────────────────────────
# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false
